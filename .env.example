# OPCIONAL. Sem este arquivo, o Compose usa os padrões de desenvolvimento.
# Para personalizar:  cp .env.example .env   (o .env não é versionado)

# Portas publicadas no host
WEB_PORT=4200
API_PORT=8080
DB_PORT=5434

# Banco de dados
DB_NAME=easy_eats
DB_USER=postgres
DB_PASSWORD=easyeats

# Segredo JWT em Base64 (mínimo 32 bytes). Gere com: openssl rand -base64 32
# JWT_SECRET=

# Origem do build do frontend (padrão: repositório no GitHub). Cópia local:
# FRONTEND_CONTEXT=../Easy-Eats
